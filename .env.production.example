NODE_ENV=production
APP_NAME=chatbot-alice
APP_DISPLAY_NAME=ALICE
APP_PORT=3000
APP_PREFIX=api/v1
APP_CORS_ORIGINS=https://your-frontend.example.com
APP_BODY_LIMIT=1mb
LOG_LEVEL=info
SWAGGER_ENABLED=false

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=alice
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot_alice
DATABASE_URL=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_PREFIX=alice
WHATSAPP_INBOUND_QUEUE=whatsapp-inbound
WHATSAPP_OUTBOUND_QUEUE=whatsapp-outbound
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=3000

WHATSAPP_PROVIDER=meta
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VALIDATE_SIGNATURE=true

AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=600
AI_STORE=false
