NODE_ENV=test
APP_NAME=chatbot-alice
APP_DISPLAY_NAME=ALICE
APP_PORT=3001
APP_PREFIX=api/v1
APP_CORS_ORIGINS=http://localhost
APP_BODY_LIMIT=1mb
LOG_LEVEL=silent
SWAGGER_ENABLED=false

DATABASE_URL=postgresql://alice:alice_local_password@localhost:5432/chatbot_alice_test?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
BULLMQ_PREFIX=alice-test
WHATSAPP_INBOUND_QUEUE=whatsapp-inbound-test
WHATSAPP_OUTBOUND_QUEUE=whatsapp-outbound-test
QUEUE_ATTEMPTS=1
QUEUE_BACKOFF_MS=100

WHATSAPP_PROVIDER=mock
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=test-verify-token
WHATSAPP_APP_SECRET=test-app-secret
WHATSAPP_VALIDATE_SIGNATURE=false

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=5000
OPENAI_MAX_OUTPUT_TOKENS=100
OPENAI_STORE=false
