NODE_ENV=development
APP_NAME=chatbot-alice
APP_DISPLAY_NAME=ALICE
APP_PORT=3000
APP_PREFIX=api/v1
APP_CORS_ORIGINS=http://localhost:4200,http://localhost:5173
APP_BODY_LIMIT=1mb
LOG_LEVEL=debug
SWAGGER_ENABLED=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=alice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chatbot_alice
DATABASE_URL=postgresql://alice:change-me@localhost:5432/chatbot_alice?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_PREFIX=alice
WHATSAPP_INBOUND_QUEUE=whatsapp-inbound
WHATSAPP_OUTBOUND_QUEUE=whatsapp-outbound
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=3000

WHATSAPP_PROVIDER=mock
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_VALIDATE_SIGNATURE=false

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_STORE=false
